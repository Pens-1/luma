# =====================
# n8n基本設定
# =====================

# n8n管理画面のBasic認証設定（セキュリティのため設定推奨）
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your_secure_password_here

# タイムゾーン設定
GENERIC_TIMEZONE=Asia/Tokyo

# =====================
# API認証情報
# =====================

# Google Gemini APIキー（Google AI Studioから取得）
# https://ai.google.dev/
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Slack Incoming Webhook URL（Slack Appから取得）
# https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=your_slack_webhook_url_here

# Discord Webhook URL（Discordサーバー設定から取得）
# サーバー設定 → 連携サービス → ウェブフック → 新しいウェブフック
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# =====================
# その他設定
# =====================

# n8nのデータディレクトリ（変更不要）
N8N_USER_FOLDER=/home/node/.n8n

# Webhook URL（ローカル開発時は変更不要）
WEBHOOK_URL=http://localhost:5678/
